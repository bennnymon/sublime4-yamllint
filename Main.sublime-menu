[
    {
        "caption": "Tools",
        "mnemonic": "T",
        "id": "tools",
        "children": [
            { "caption": "-", "id": "yamllint-separator" },
            {
                "caption": "YAMLLint",
                "id": "yamllint",
                "children": [
                    { "caption": "Lint Current File", "command": "yamllint_lint" },
                    { "caption": "Fix Current File (yamlfix)", "command": "yamllint_fix" },
                    { "caption": "Clear Results", "command": "yamllint_clear" },
                    { "caption": "Show Output Panel", "command": "yamllint_show_panel" },
                    { "caption": "-" },
                    { "caption": "Go to Next Issue", "command": "yamllint_goto_next_issue" },
                    { "caption": "Go to Previous Issue", "command": "yamllint_goto_prev_issue" },
                    { "caption": "-" },
                    {
                        "caption": "Settings",
                        "command": "edit_settings",
                        "args": {
                            "base_file": "${packages}/YamlLint/yamllint.sublime-settings",
                            "default": "// YAMLLint Settings — User\n{\n\t$0\n}\n"
                        }
                    }
                ]
            }
        ]
    }
]
